{
  "id": null,
  "uid": "food-delivery-rabbitmq",
  "title": "Food Delivery - RabbitMQ (Spring AMQP)",
  "tags": ["food-delivery","rabbitmq"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Total Connections", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(rabbitmq_connections)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 2, "title": "Total Channels", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(rabbitmq_channels)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 3, "title": "Published/sec (5m)", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(rate(rabbitmq_published_total[5m]))", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 4, "title": "Consumed/sec (5m)", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(rate(rabbitmq_consumed_total[5m]))", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 5, "title": "Publish Rate per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rate(rabbitmq_published_total[1m]))", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 6, "title": "Consume Rate per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rate(rabbitmq_consumed_total[1m]))", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 7, "title": "Acknowledged Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rate(rabbitmq_acknowledged_total[1m]))", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 8, "title": "Rejected/Failed Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rate(rabbitmq_rejected_total[1m]))", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 9, "title": "Connections per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rabbitmq_connections)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 10, "title": "Channels per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rabbitmq_channels)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]}
  ]
}