    {"id": 2, "title": "Total Idle Connections", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(hikaricp_connections_idle)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 3, "title": "Total Pool Size", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(hikaricp_connections)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 4, "title": "Pending Threads", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum(hikaricp_connections_pending)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 5, "title": "Active Connections per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (hikaricp_connections_active)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 6, "title": "Idle Connections per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (hikaricp_connections_idle)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 7, "title": "Pool Size per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (hikaricp_connections)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 8, "title": "Pending Threads per Service", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (hikaricp_connections_pending)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]},
    {"id": 9, "title": "Connection Acquire Time (max)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "max by (application) (hikaricp_connections_acquire_seconds_max)", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 10, "title": "Connection Timeouts", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "targets": [{"expr": "sum by (application) (rate(hikaricp_connections_timeout_total[5m]))", "legendFormat": "{{application}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus-uid"}}]}
